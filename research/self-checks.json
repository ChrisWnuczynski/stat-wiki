    },
    {
      "title": "Mean of what remains",
      "prompt": "Using the same reduced dataset 2, 4, 3, 2, what is the mean?",
      "answer": "The total is 11 and there are 4 observations, so the mean is 11/4 = 2.75."
    }
  ],
  "variable": [
    {
