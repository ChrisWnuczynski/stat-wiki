  "cauchy-distribution": {
    "name": "Cauchy",
    "kind": "continuous",
    "notation": "$X\\sim\\operatorname{Cauchy}(x_0,\\gamma)$",
    "parameters": "$x_0\\in\\mathbb{R}$, $\\gamma>0$",
    "support": "$x\\in\\mathbb{R}$",
    "pdf": "$f(x)=\\gamma/[\\pi((x-x_0)^2+\\gamma^2)]$",
    "cdf": "$F(x)=1/2+\\arctan((x-x_0)/\\gamma)/\\pi$",
    "quantile": "$Q(p)=x_0+\\gamma\\tan(\\pi(p-1/2))$",
