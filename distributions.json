  "bernoulli-distribution": {
    "name": "Bernoulli",
    "kind": "discrete",
    "notation": "$X\\sim\\operatorname{Bernoulli}(p)$",
    "parameters": "$0\\le p\\le1$",
    "support": "$x\\in\\{0,1\\}$",
    "pmf": "$p(x)=p^x(1-p)^{1-x}$",
    "cdf": "$F(x)=0$ for $x<0$, $1-p$ for $0\\le x<1$, $1$ for $x\\ge1$",
    "mean": "$p$",
    "variance": "$p(1-p)$",
    "mode": "$0$ if $p<1/2$; $1$ if $p>1/2$",
    "mgf": "$1-p+pe^t$",
    "pdf": "",
    "quantile": "",
    "median": "",
    "skewness": "",
