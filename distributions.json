{
  "bernoulli-distribution": {
    "name": "Bernoulli",
    "kind": "discrete",
    "notation": "$X\\sim\\operatorname{Bernoulli}(p)$",
    "parameters": "$0\\le p\\le1$",
    "support": "$x\\in\\{0,1\\}$",
    "pmf": "$p(x)=p^x(1-p)^{1-x}$",
    "cdf": "$F(x)=0$ for $x<0$, $1-p$ for $0\\le x<1$, $1$ for $x\\ge1$",
    "mean": "$p$",
    "variance": "$p(1-p)$",
    "mode": "$0$ for $p<1/2$; $1$ for $p>1/2$; both for $p=1/2$",
    "mgf": "$1-p+pe^t$",
    "pdf": "",
    "quantile": "",
    "median": "$0$ for $p<1/2$; $1$ for $p>1/2$; any value in $[0,1]$ for $p=1/2$",
    "skewness": "$(1-2p)/\\sqrt{p(1-p)}$ for $0<p<1$",
    "excess_kurtosis": "$[1-6p(1-p)]/[p(1-p)]$ for $0<p<1$",
    "entropy": "$-p\\log p-(1-p)\\log(1-p)$, with $0\\log0=0$",
    "characteristic_function": "$1-p+pe^{it}$",
    "fisher_information": "$I(p)=1/[p(1-p)]$ for $0<p<1$, per observation",
    "conjugate_prior": "",
    "related": [
      "binomial-distribution"
    ],
    "plot": {
      "scipy": "bernoulli",
      "args": [
        0.35
      ],
      "domain": [
        0,
        1
      ],
      "parameters": "p=0.35",
      "views": [
        "pdf",
        "cdf"
      ]
    },
    "description": "a two-outcome distribution for a single success or failure",
    "symbols": "where p is the probability of success and x records failure or success",
    "notation_symbols": [
      {
        "symbol": "$p$",
        "meaning": "success probability"
      },
      {
        "symbol": "$X$",
        "meaning": "binary outcome"
      }
    ],
    "history": "",
    "sampling": "Draw a uniform value $U$ between zero and one, then return $1$ when $U<p$ and $0$ otherwise, where $p$ is the success probability.",
    "conjugate_prior_for": ""
  },
  "beta-distribution": {
    "name": "Beta",
    "kind": "continuous",
    "notation": "$X\\sim\\operatorname{Beta}(\\alpha,\\beta)$",
    "parameters": "$\\alpha,\\beta>0$",
    "support": "$0<x<1$",
    "pdf": "$p(x)=\\frac{\\Gamma(\\alpha+\\beta)}{\\Gamma(\\alpha)\\Gamma(\\beta)}x^{\\alpha-1}(1-x)^{\\beta-1}$",
    "mean": "$\\mathbb{E}(X)=\\alpha/(\\alpha+\\beta)$",
    "variance": "$\\operatorname{Var}(X)=\\alpha\\beta/((\\alpha+\\beta)^{2}(\\alpha+\\beta+1))$",
    "pmf": "",
    "cdf": "$F(x)=I_x(\\alpha,\\beta)$",
    "quantile": "",
    "median": "",
    "mode": "$(\\alpha-1)/(\\alpha+\\beta-2)$ for $\\alpha,\\beta>1$; boundary mode if a shape is at most $1$, except all $x\\in[0,1]$ when $\\alpha=\\beta=1$",
    "skewness": "$2(\\beta-\\alpha)\\sqrt{\\alpha+\\beta+1}/[(\\alpha+\\beta+2)\\sqrt{\\alpha\\beta}]$",
    "excess_kurtosis": "$6[(\\alpha-\\beta)^2(\\alpha+\\beta+1)-\\alpha\\beta(\\alpha+\\beta+2)]/[\\alpha\\beta(\\alpha+\\beta+2)(\\alpha+\\beta+3)]$",
    "entropy": "$\\log B(\\alpha,\\beta)-(\\alpha-1)\\psi(\\alpha)-(\\beta-1)\\psi(\\beta)+(\\alpha+\\beta-2)\\psi(\\alpha+\\beta)$",
    "mgf": "${}_1F_1(\\alpha;\\alpha+\\beta;t)$",
    "characteristic_function": "${}_1F_1(\\alpha;\\alpha+\\beta;it)$",
    "fisher_information": "$I(\\alpha,\\beta)=\\begin{pmatrix}\\psi_1(\\alpha)-\\psi_1(\\alpha+\\beta)&-\\psi_1(\\alpha+\\beta)\\\\-\\psi_1(\\alpha+\\beta)&\\psi_1(\\beta)-\\psi_1(\\alpha+\\beta)\\end{pmatrix}$ per observation",
    "conjugate_prior": "",
    "related": [],
    "plot": {
      "scipy": "beta",
      "args": [
        2,
        5
      ],
      "domain": [
        0,
        1
      ],
      "parameters": "α=2, β=5",
      "views": [
        "pdf",
        "cdf"
      ]
    },
    "description": "a continuous distribution for a probability between zero and one",
    "symbols": "where α and β are positive shape parameters, Γ is the gamma function, and x is between zero and one",
    "notation_symbols": [
      {
        "symbol": "$\\alpha$",
        "meaning": "first shape parameter"
      },
      {
        "symbol": "$\\beta$",
        "meaning": "second shape parameter"
      }
    ],
    "history": "",
    "sampling": "",
    "conjugate_prior_for": "$X\\mid p\\sim\\operatorname{Bin}(n,p)$, giving $p\\mid x\\sim\\operatorname{Beta}(\\alpha+x,\\beta+n-x)$"
  },
  "binomial-distribution": {
    "name": "Binomial",
    "kind": "discrete",
    "notation": "$X\\sim\\operatorname{Bin}(n,p)$",
    "parameters": "$n\\in\\mathbb{Z}^{+}$, $p\\in[0,1]$",
    "support": "$x=0,1,\\ldots,n$",
    "pmf": "$p(x)=\\binom{n}{x}p^{x}(1-p)^{n-x}$",
    "mean": "$\\mathbb{E}(X)=np$",
    "variance": "$\\operatorname{Var}(X)=np(1-p)$",
    "pdf": "",
    "cdf": "$F(k)=\\sum_{j=0}^{\\lfloor k\\rfloor}\\binom njp^j(1-p)^{n-j}$ for $0\\le k<n$",
    "quantile": "",
    "median": "",
    "mode": "$\\lfloor(n+1)p\\rfloor$; also one less if $(n+1)p\\in\\{1,\\ldots,n\\}$ is an integer",
    "skewness": "$(1-2p)/\\sqrt{np(1-p)}$ for $0<p<1$",
    "excess_kurtosis": "$[1-6p(1-p)]/[np(1-p)]$ for $0<p<1$",
    "entropy": "$-\\sum_{k=0}^{n}\\binom nk p^k(1-p)^{n-k}\\log[\\binom nk p^k(1-p)^{n-k}]$, with $0\\log0=0$",
    "mgf": "$(1-p+pe^t)^n$",
    "characteristic_function": "$(1-p+pe^{it})^n$",
    "fisher_information": "$I(p)=n/[p(1-p)]$ for $0<p<1$, per binomial count",
    "conjugate_prior": "[Beta distribution](beta-distribution.qmd): $p\\sim\\operatorname{Beta}(\\alpha,\\beta)$, giving $p\\mid x\\sim\\operatorname{Beta}(\\alpha+x,\\beta+n-x)$",
    "related": [
      "normal-distribution"
    ],
    "plot": {
